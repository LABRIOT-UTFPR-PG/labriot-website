# ==============================================================================
# Configurações de Produção — Site Labriot (Oracle OCI + Docker Compose)
# Copie este arquivo para .env (permissão chmod 600 .env) e preencha os valores.
# NUNCA versione o arquivo .env no Git.
# ==============================================================================

# URL pública do site
NEXT_PUBLIC_SITE_URL=https://labriot.com.br

# Segurança / Autenticação Admin (OBRIGATÓRIO: mínimo 32 caracteres aleatórios)
# Gere com: openssl rand -hex 32
JWT_SECRET=substitua_por_uma_chave_aleatoria_de_64_caracteres_hex

# PostgreSQL local (Docker Compose na OCI)
POSTGRES_DB=labriot
POSTGRES_USER=labriot
POSTGRES_PASSWORD=substitua_por_uma_senha_forte_do_banco
DATABASE_SSL=false

# Opcional: se quiser usar um PostgreSQL externo (ex: Neon), descomente e ajuste:
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

# Envio de e-mails do formulário de contato (/api/contact)
# Opção A (SMTP próprio / Locaweb): preencha SMTP_HOST, SMTP_PORT, SMTP_USER e SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Opção B (Gmail com Senha de Aplicativo - deixe SMTP_HOST vazio)
EMAIL_USER=labriot.utfpr@gmail.com
EMAIL_PASS=sua_senha_de_aplicativo_google
CONTACT_TO_EMAIL=labriot.utfpr@gmail.com

# Módulo de IA (Roboflow Workflows)
ROBOFLOW_API_KEY=sua_chave_privada_roboflow
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/image-jlx1n/workflows/detect-motherboard
ROBOFLOW_RATE_LIMIT_PER_HOUR=15
ROBOFLOW_DAILY_LIMIT=250

# Opcional: apenas se desejar exibir a aba do Widget Oficial (iframe) na página /projects/roboflow
NEXT_PUBLIC_ROBOFLOW_EMBED_URL=
